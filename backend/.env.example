# backend/.env  (copy this file to .env; .env is git-ignored)
# MODE picks the LOCAL_ or LIVE_ value of each pair. Local dev: local. Render sets MODE=live itself.
MODE=local
PORT=5000

# ---- local (your machine)
# Always name the database (/vernyr_dev): without a name MongoDB uses "test".
LOCAL_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vernyr_dev?appName=Cluster0
LOCAL_CLIENT_CRM_URL=http://localhost:3000
LOCAL_CLIENT_STUDENT_URL=http://localhost:3001
LOCAL_CLIENT_PARTNER_URL=http://localhost:3003

# ---- live (Render). Never the same database as local.
LIVE_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vernyr?appName=Cluster0
LIVE_CLIENT_CRM_URL=https://crm.vernyr.com
LIVE_CLIENT_STUDENT_URL=https://portal.vernyr.com
LIVE_CLIENT_PARTNER_URL=https://partner.vernyr.com

# ---- both
# 48+ random bytes. `npm run doctor` prints a fresh one when this is weak.
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vernyr-docs

# First Admin for `npm run bootstrap` (password is generated and printed once when empty)
ADMIN_EMAIL=
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=

# Local only: unauthenticated /dev console in the CRM. Never on Render.
ENABLE_DEV_ROUTES=true
