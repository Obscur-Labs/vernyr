# local | live — picks the LOCAL_/LIVE_ values below.
MODE=local

PORT=5000

# ── local ────────────────────────────────────────────────────────────────────
LOCAL_MONGODB_URI=mongodb://localhost:27017/studycrm
LOCAL_CLIENT_CRM_URL=http://localhost:3000
LOCAL_CLIENT_STUDENT_URL=http://localhost:3001

# ── live ─────────────────────────────────────────────────────────────────────
LIVE_MONGODB_URI=
LIVE_CLIENT_CRM_URL=https://crm.vernyr.com
LIVE_CLIENT_STUDENT_URL=https://portal.vernyr.com

# ── both modes ───────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# From the Cloudinary dashboard → Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=la-europa-docs

# Unauthenticated /api/dev router. Ignored unless NODE_ENV is not 'production',
# and requests must come from localhost. Never set this on a deployed backend.
ENABLE_DEV_ROUTES=false
