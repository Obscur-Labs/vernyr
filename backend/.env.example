PORT=5000
MONGODB_URI=mongodb://localhost:27017/studycrm
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
# Browser origins allowed through CORS and Socket.io. In production these are
# the deployed frontend URLs, e.g. https://crm.example.com — no trailing path.
# Each accepts a comma-separated list if you need to allow more than one host
# (say the apex and the www variant during a DNS cutover).
CLIENT_CRM_URL=http://localhost:3000
CLIENT_STUDENT_URL=http://localhost:3001

# ── Cloudinary (file storage) ────────────────────────────────────────────────
# From the Cloudinary dashboard → Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative to the three vars above — the SDK reads this one automatically:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Root folder every upload is nested under. Files are organised as:
#   <CLOUDINARY_FOLDER>/students/<studentId>/documents/
#   <CLOUDINARY_FOLDER>/chat/<conversationId>/files/
#   <CLOUDINARY_FOLDER>/chat/<conversationId>/voice/
CLOUDINARY_FOLDER=la-europa-docs

# ── Developer console ────────────────────────────────────────────────────────
# Mounts an UNAUTHENTICATED /api/dev router backing the CRM's /dev page.
# Ignored unless NODE_ENV is not 'production', and requests must come from
# localhost. Leave this unset anywhere that is not your own machine.
ENABLE_DEV_ROUTES=false
