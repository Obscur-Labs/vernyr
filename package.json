{
  "name": "studycrm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "crm",
    "student",
    "website"
  ],
  "scripts": {
    "dev": "concurrently -n backend,crm,student,website -c blue,green,magenta,cyan \"npm:dev:backend\" \"npm:dev:crm\" \"npm:dev:student\" \"npm:dev:website\"",
    "dev:backend": "npm run dev -w backend",
    "dev:crm": "npm run dev -w crm",
    "dev:student": "npm run dev -w student",
    "dev:website": "npm run dev -w website",
    "build": "npm run build:backend && npm run build:crm && npm run build:student && npm run build:website",
    "build:backend": "npm run build -w backend",
    "build:crm": "npm run build -w crm",
    "build:student": "npm run build -w student",
    "build:website": "npm run build -w website",
    "start": "concurrently -n backend,crm,student,website -c blue,green,magenta,cyan \"npm:start:backend\" \"npm:start:crm\" \"npm:start:student\" \"npm:start:website\"",
    "start:backend": "npm run start -w backend",
    "start:crm": "npm run start -w crm",
    "start:student": "npm run start -w student",
    "start:website": "npm run start -w website",
    "typecheck": "npm run typecheck:backend && npm run typecheck:crm && npm run typecheck:student && npm run typecheck:website",
    "typecheck:backend": "tsc --noEmit -p backend",
    "typecheck:crm": "tsc --noEmit -p crm",
    "typecheck:student": "tsc --noEmit -p student",
    "typecheck:website": "tsc --noEmit -p website",
    "seed": "npm run seed -w backend",
    "migrate:usernames": "npm run migrate:usernames -w backend",
    "migrate:roles": "npm run migrate:roles -w backend",
    "migrate:blank-credentials": "npm run migrate:blank-credentials -w backend",
    "clean": "rimraf node_modules backend/node_modules crm/node_modules student/node_modules backend/dist crm/.next student/.next",
    "migrate:split-accounts": "npm run migrate:split-accounts -w backend",
    "migrate:counsellors": "npm run migrate:counsellors -w backend",
    "import:courses": "npm run import:courses -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
