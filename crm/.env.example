# crm/.env  (admin portal; public addresses only, no secrets)
# local = talk to the API on your machine. Vercel sets live itself.
NEXT_PUBLIC_MODE=local

NEXT_PUBLIC_LOCAL_API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_LOCAL_STUDENT_URL=http://localhost:3001

NEXT_PUBLIC_LIVE_API_ORIGIN=https://api.vernyr.com
NEXT_PUBLIC_LIVE_STUDENT_URL=https://portal.vernyr.com
